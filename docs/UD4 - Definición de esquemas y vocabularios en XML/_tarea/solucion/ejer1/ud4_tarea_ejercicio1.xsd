<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  
  <!-- Documentación general del esquema -->
  <xs:annotation>
    <xs:documentation>
      Esquema XSD para validar inventarios de impresoras.
      Define la estructura y restricciones para documentos XML que contienen
      información técnica y de configuración de impresoras.
    </xs:documentation>
  </xs:annotation>

  <!-- TIPOS SIMPLES PERSONALIZADOS -->

  <!-- Tipo para el número de serie de la impresora: i + 5 números -->
  <xs:simpleType name="NumSerieTipo">
    <xs:annotation>
      <xs:documentation>
        Formato del número de serie: i seguido de exactamente 5 dígitos.
        Ejemplo: i00245, i00246
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="i[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipo para la tecnología de impresión: matricial, láser o tinta -->
  <xs:simpleType name="TecnologiaTipo">
    <xs:annotation>
      <xs:documentation>
        Enumera los tipos de tecnología de impresión permitidos:
        - matricial: impresoras de agujas
        - láser: impresoras láser
        - tinta: impresoras de inyección de tinta
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="matricial"/>
      <xs:enumeration value="láser"/>
      <xs:enumeration value="tinta"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipo para el año de compra: número entero positivo -->
  <xs:simpleType name="AnoCompraTipo">
    <xs:annotation>
      <xs:documentation>
        Año de compra de la impresora. Debe ser un número entero positivo,
        típicamente entre 1950 y el año actual.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:int">
      <xs:minInclusive value="1950"/>
      <xs:maxInclusive value="2100"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipo para el peso con restricciones en decimales -->
  <xs:simpleType name="PesoTipo">
    <xs:annotation>
      <xs:documentation>
        Peso de la impresora: número positivo con máximo 2 decimales.
        Ejemplo: 4.52, 3.2, 5
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <!-- Patrón que asegura máximo 2 decimales: 1 a 5 dígitos antes del punto, 0-2 después -->
      <xs:pattern value="[0-9]+(\.[0-9]{1,2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipo para la unidad de peso -->
  <xs:simpleType name="UnidadPesoTipo">
    <xs:annotation>
      <xs:documentation>
        Unidades de medida permitidas para el peso:
        - kg: kilogramos
        - g: gramos
        - lb: libras
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="kg"/>
      <xs:enumeration value="g"/>
      <xs:enumeration value="lb"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipo para el tamaño de papel -->
  <xs:simpleType name="TamanoPapelTipo">
    <xs:annotation>
      <xs:documentation>
        Tamaños estándar de papel soportados por la impresora.
        Ejemplos: A3, A4, A5, Carta, Oficio
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="A3"/>
      <xs:enumeration value="A4"/>
      <xs:enumeration value="A5"/>
      <xs:enumeration value="Carta"/>
      <xs:enumeration value="Oficio"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Tipo para el código del cartucho: C- + 3 números + 1-2 letras mayúsculas -->
  <xs:simpleType name="CodigoCartuchoTipo">
    <xs:annotation>
      <xs:documentation>
        Formato del código de cartucho: C- seguido de 3 números y 1 o 2 letras mayúsculas.
        Ejemplos: C-123A, C-456BV, C-789XYZ
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="C-[0-9]{3}[A-Z]{1,2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- TIPOS COMPLEJOS -->

  <!-- Tipo complejo para un elemento peso con unidad como atributo -->
  <xs:complexType name="PesoAtributoTipo">
    <xs:annotation>
      <xs:documentation>
        Tipo complejo que contiene el peso como contenido de texto
        y la unidad de medida como atributo obligatorio.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension base="PesoTipo">
        <xs:attribute name="unidad" type="UnidadPesoTipo" use="required">
          <xs:annotation>
            <xs:documentation>
              Unidad de medida del peso (kg, g, o lb). Atributo obligatorio.
            </xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <!-- Tipo complejo para una impresora individual -->
  <xs:complexType name="ImpresoraTipo">
    <xs:annotation>
      <xs:documentation>
        Define la estructura de una impresora con sus características técnicas,
        capacidades y datos de compra.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <!-- Fabricante: cadena obligatoria -->
      <xs:element name="fabricante" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nombre del fabricante (Epson, HP, Canon, etc.)</xs:documentation>
        </xs:annotation>
      </xs:element>
      
      <!-- Modelo: cadena obligatoria -->
      <xs:element name="modelo" type="xs:string">
        <xs:annotation>
          <xs:documentation>Modelo específico de la impresora (EPL300, LaserJet 2410, etc.)</xs:documentation>
        </xs:annotation>
      </xs:element>
      
      <!-- Peso: número positivo con máximo 2 decimales y unidad -->
      <xs:element name="peso" type="PesoAtributoTipo">
        <xs:annotation>
          <xs:documentation>
            Peso de la impresora como número positivo con hasta 2 decimales.
            La unidad de medida se especifica en el atributo 'unidad'.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      
      <!-- Tamaños de papel: puede haber uno o más -->
      <xs:element name="tamaño" type="TamanoPapelTipo" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>
            Tamaños de papel que soporta. Puede haber múltiples elementos tamaño.
            El minOccurs es 1 por defecto, así que al menos uno es obligatorio.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      
      <!-- Cartucho: código con patrón específico -->
      <xs:element name="cartucho" type="CodigoCartuchoTipo">
        <xs:annotation>
          <xs:documentation>
            Código del cartucho utilizado. Formato: C- + 3 números + 1-2 letras mayúsculas.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      
      <!-- En red: elemento vacío, opcional -->
      <xs:element name="enred" minOccurs="0">
        <xs:annotation>
          <xs:documentation>
            Indica si la impresora está conectada en red.
            Es un elemento vacío y opcional.
          </xs:documentation>
        </xs:annotation>
        <xs:complexType/>
      </xs:element>
    </xs:sequence>
    
    <!-- ATRIBUTOS DE IMPRESORA -->
    
    <!-- Número de serie: identificador único con patrón i + 5 números -->
    <xs:attribute name="numSerie" type="NumSerieTipo" use="required">
      <xs:annotation>
        <xs:documentation>
          Número de serie único. Formato: i seguido de 5 dígitos.
          Ejemplo: i00245
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    
    <!-- Tecnología: atributo obligatorio con valores enumerados -->
    <xs:attribute name="tecnologia" type="TecnologiaTipo" use="required">
      <xs:annotation>
        <xs:documentation>
          Tipo de tecnología de impresión. Valores permitidos:
          matricial, láser, tinta
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    
    <!-- Año de compra: atributo opcional -->
    <xs:attribute name="compra" type="AnoCompraTipo" use="optional">
      <xs:annotation>
        <xs:documentation>
          Año en que se compró la impresora. Es un atributo opcional.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ELEMENTO RAÍZ -->

  <!-- Elemento raíz: impresoras -->
  <xs:element name="impresoras">
    <xs:annotation>
      <xs:documentation>
        Elemento raíz que contiene una o más impresoras.
        Este es el elemento que aparece en la parte superior del documento XML.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <!-- Puede haber una o más impresoras (maxOccurs unbounded) -->
        <xs:element name="impresora" type="ImpresoraTipo" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>
              Elemento que define una impresora individual con todos sus atributos
              y datos técnicos. Al menos una es obligatoria.
            </xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
