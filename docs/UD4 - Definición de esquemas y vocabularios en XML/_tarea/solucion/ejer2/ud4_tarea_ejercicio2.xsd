<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  
  <!-- Documentación general del esquema -->
  <xs:annotation>
    <xs:documentation>
      Esquema XSD para una plataforma de alquiler de vehículos autónomos.
      Define la estructura y restricciones para gestionar clientes, sucursales,
      vehículos con diferentes niveles de automatización, reservas y seguros.
    </xs:documentation>
  </xs:annotation>

  <!-- ============================================ -->
  <!-- TIPOS SIMPLES PERSONALIZADOS -->
  <!-- ============================================ -->

  <!-- Identificadores únicos con formatos específicos -->
  
  <xs:simpleType name="IDClienteTipo">
    <xs:annotation>
      <xs:documentation>
        Identificador único de cliente: cli + 4 dígitos.
        Ejemplo: cli0001, cli0042
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="cli[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IDVehiculoTipo">
    <xs:annotation>
      <xs:documentation>
        Identificador único de vehículo: veh + 4 dígitos.
        Ejemplo: veh0001, veh0025
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="veh[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IDSucursalTipo">
    <xs:annotation>
      <xs:documentation>
        Identificador único de sucursal: suc + 3 dígitos.
        Ejemplo: suc001, suc042
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="suc[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IDReservaTipo">
    <xs:annotation>
      <xs:documentation>
        Identificador único de reserva: res + 4 dígitos.
        Ejemplo: res0001, res0100
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="res[0-9]{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="IDSeguroTipo">
    <xs:annotation>
      <xs:documentation>
        Identificador único de seguro: seg + 3 dígitos.
        Ejemplo: seg001, seg042
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="seg[0-9]{3}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Documentación personal -->
  
  <xs:simpleType name="DNITipo">
    <xs:annotation>
      <xs:documentation>
        Documento Nacional de Identidad español: 8 dígitos + 1 letra mayúscula.
        Ejemplo: 12345678A, 98765432Z
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{8}[A-Z]"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NIETipo">
    <xs:annotation>
      <xs:documentation>
        Número de Identidad de Extranjero: X, Y o Z + 7 dígitos + 1 letra mayúscula.
        Ejemplo: X1234567A, Y9876543Z
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[XYZ][0-9]{7}[A-Z]"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EmailTipo">
    <xs:annotation>
      <xs:documentation>
        Email con patrón básico: caracteres @ dominio con punto.
        Ejemplo: juan.perez@email.com
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[^@]+@[^@]+\.[^@]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TelefonoTipo">
    <xs:annotation>
      <xs:documentation>
        Número de teléfono: exactamente 9 dígitos.
        Ejemplo: 914567890, 666123456
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{9}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="CodigoPostalTipo">
    <xs:annotation>
      <xs:documentation>
        Código postal: exactamente 5 dígitos.
        Ejemplo: 28001, 08002
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{5}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Vehículos -->
  
  <xs:simpleType name="MatriculaTipo">
    <xs:annotation>
      <xs:documentation>
        Matrícula alfanumérica: 5 a 10 caracteres (letras mayúsculas y dígitos).
        Acepta formatos internacionales.
        Ejemplo: MAD0001, ABC1234, 0002NNN
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9]{5,10}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AnoFabricacionTipo">
    <xs:annotation>
      <xs:documentation>
        Año de fabricación: entero entre 1900 y año actual.
        Ejemplo: 2023, 2024
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:int">
      <xs:minInclusive value="1900"/>
      <xs:maxInclusive value="2100"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoVehiculoTipo">
    <xs:annotation>
      <xs:documentation>
        Tipo de vehículo disponible en la flota.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="turismo"/>
      <xs:enumeration value="suv"/>
      <xs:enumeration value="furgoneta"/>
      <xs:enumeration value="camion"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoCombustibleTipo">
    <xs:annotation>
      <xs:documentation>
        Tipo de combustible o energía del vehículo.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="gasolina"/>
      <xs:enumeration value="diesel"/>
      <xs:enumeration value="electrico"/>
      <xs:enumeration value="hibrido"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NivelAutomatizacionTipo">
    <xs:annotation>
      <xs:documentation>
        Nivel de automatización según normas SAE J3016:
        0 - Sin automatización (conducción manual)
        1 - Asistencia de conducción
        2 - Automatización parcial
        3 - Automatización condicional
        4 - Automatización alta
        5 - Automatización completa
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:int">
      <xs:minInclusive value="0"/>
      <xs:maxInclusive value="5"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SistemaActivoTipo">
    <xs:annotation>
      <xs:documentation>
        Sistemas de automatización activos en el vehículo.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="freno-automatico"/>
      <xs:enumeration value="cambio-carril-automatico"/>
      <xs:enumeration value="estacionamiento-automatico"/>
      <xs:enumeration value="conduccion-autonoma-autopista"/>
      <xs:enumeration value="conduccion-autonoma-completa"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="EstadoVehiculoTipo">
    <xs:annotation>
      <xs:documentation>
        Estado operativo del vehículo en la flota.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="disponible"/>
      <xs:enumeration value="alquilado"/>
      <xs:enumeration value="en-mantenimiento"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="PrecioTipo">
    <xs:annotation>
      <xs:documentation>
        Precio con exactamente 2 decimales (para euros).
        Ejemplo: 89.99, 9.99, 100.00
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:pattern value="[0-9]+\.[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConsumoDiarioTipo">
    <xs:annotation>
      <xs:documentation>
        Consumo medio: número decimal positivo con hasta 2 decimales.
        Unidad: l/100km o kWh/100km según combustible.
        Ejemplo: 6.5, 18, 5.25
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0"/>
      <xs:pattern value="[0-9]+(\.[0-9]{1,2})?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Seguros -->
  
  <xs:simpleType name="CoberturaSeguroTipo">
    <xs:annotation>
      <xs:documentation>
        Nivel de cobertura disponible en los seguros.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="basica"/>
      <xs:enumeration value="estandar"/>
      <xs:enumeration value="premium"/>
      <xs:enumeration value="integral"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Reservas -->
  
  <xs:simpleType name="EstadoReservaTipo">
    <xs:annotation>
      <xs:documentation>
        Estado de una reserva en el sistema.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="confirmada"/>
      <xs:enumeration value="pendiente"/>
      <xs:enumeration value="completada"/>
      <xs:enumeration value="cancelada"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ============================================ -->
  <!-- TIPOS COMPLEJOS -->
  <!-- ============================================ -->

  <!-- Dirección -->
  <xs:complexType name="DireccionTipo">
    <xs:annotation>
      <xs:documentation>
        Estructura común para direcciones (clientes y sucursales).
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="calle" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nombre de la calle</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="numero" type="xs:string">
        <xs:annotation>
          <xs:documentation>Número de la calle (puede incluir letras)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ciudad" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nombre de la ciudad</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="codigoPostal" type="CodigoPostalTipo">
        <xs:annotation>
          <xs:documentation>Código postal: 5 dígitos</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Horario -->
  <xs:complexType name="HorarioTipo">
    <xs:annotation>
      <xs:documentation>
        Define horario de apertura y cierre de sucursales.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="horaApertura" type="xs:time">
        <xs:annotation>
          <xs:documentation>Hora de apertura en formato HH:MM:SS</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="horaCierre" type="xs:time">
        <xs:annotation>
          <xs:documentation>Hora de cierre en formato HH:MM:SS</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Permiso de conducir -->
  <xs:complexType name="PermisoConducirTipo">
    <xs:annotation>
      <xs:documentation>
        Información del permiso de conducir del cliente.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="numero" type="xs:string">
        <xs:annotation>
          <xs:documentation>Número del permiso de conducir</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="vigenciaHasta" type="xs:date">
        <xs:annotation>
          <xs:documentation>Fecha de vigencia del permiso (YYYY-MM-DD)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Datos personales del cliente -->
  <xs:complexType name="DatosPersonalesTipo">
    <xs:annotation>
      <xs:documentation>
        Datos personales y de conducción del cliente.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="fechaNacimiento" type="xs:date">
        <xs:annotation>
          <xs:documentation>Fecha de nacimiento en formato YYYY-MM-DD</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="permisoConducir" type="PermisoConducirTipo">
        <xs:annotation>
          <xs:documentation>Información del permiso de conducir</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Identificación del cliente (DNI o NIE) -->
  <xs:complexType name="IdentificacionClienteTipo">
    <xs:annotation>
      <xs:documentation>
        Permite elegir entre DNI (español) o NIE (extranjero).
      </xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="dni" type="DNITipo">
        <xs:annotation>
          <xs:documentation>DNI para ciudadanos españoles</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nie" type="NIETipo">
        <xs:annotation>
          <xs:documentation>NIE para ciudadanos extranjeros</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:choice>
  </xs:complexType>

  <!-- Cliente completo -->
  <xs:complexType name="ClienteTipo">
    <xs:annotation>
      <xs:documentation>
        Información completa de un cliente incluyendo datos personales,
        documentación e información de contacto.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="nombre" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nombre del cliente</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="apellidos" type="xs:string">
        <xs:annotation>
          <xs:documentation>Apellidos del cliente</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:group ref="IdentificacionGrupo">
        <xs:annotation>
          <xs:documentation>DNI o NIE del cliente</xs:documentation>
        </xs:annotation>
      </xs:group>
      <xs:element name="email" type="EmailTipo">
        <xs:annotation>
          <xs:documentation>Email de contacto</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="telefono" type="TelefonoTipo">
        <xs:annotation>
          <xs:documentation>Teléfono de contacto (9 dígitos)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="datosPersonales" type="DatosPersonalesTipo">
        <xs:annotation>
          <xs:documentation>Datos personales y del permiso de conducir</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="direccion" type="DireccionTipo">
        <xs:annotation>
          <xs:documentation>Dirección de domicilio del cliente</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="IDClienteTipo" use="required">
      <xs:annotation>
        <xs:documentation>Identificador único: cli + 4 dígitos</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Grupo para identificación (reutilizable) -->
  <xs:group name="IdentificacionGrupo">
    <xs:annotation>
      <xs:documentation>Grupo que permite elegir DNI o NIE</xs:documentation>
    </xs:annotation>
    <xs:choice>
      <xs:element name="dni" type="DNITipo"/>
      <xs:element name="nie" type="NIETipo"/>
    </xs:choice>
  </xs:group>

  <!-- Sucursal -->
  <xs:complexType name="SucursalTipo">
    <xs:annotation>
      <xs:documentation>
        Información completa de una sucursal de alquiler.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="nombre" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nombre de la sucursal</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ciudad" type="xs:string">
        <xs:annotation>
          <xs:documentation>Ciudad donde está ubicada</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="telefono" type="TelefonoTipo">
        <xs:annotation>
          <xs:documentation>Teléfono de contacto (9 dígitos)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="direccion" type="DireccionTipo">
        <xs:annotation>
          <xs:documentation>Dirección completa de la sucursal</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="horario" type="HorarioTipo">
        <xs:annotation>
          <xs:documentation>Horario de apertura y cierre</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="plazasAparcamiento" type="xs:int">
        <xs:annotation>
          <xs:documentation>Número de plazas de aparcamiento disponibles</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="IDSucursalTipo" use="required">
      <xs:annotation>
        <xs:documentation>Identificador único: suc + 3 dígitos</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Características técnicas del vehículo -->
  <xs:complexType name="CaracteristicasTipo">
    <xs:annotation>
      <xs:documentation>
        Especificaciones técnicas del vehículo.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="potencia" type="xs:int">
        <xs:annotation>
          <xs:documentation>Potencia en CV (caballos de vapor)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="capacidadMaletero" type="xs:int">
        <xs:annotation>
          <xs:documentation>Capacidad de maletero en litros</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="plazas" type="xs:int">
        <xs:annotation>
          <xs:documentation>Número de plazas (1-9)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="consumoMedio" type="ConsumoDiarioTipo">
        <xs:annotation>
          <xs:documentation>Consumo medio en l/100km o kWh/100km</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Automatización del vehículo -->
  <xs:complexType name="AutomatizacionTipo">
    <xs:annotation>
      <xs:documentation>
        Información sobre los sistemas de automatización del vehículo.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="nivel" type="NivelAutomatizacionTipo">
        <xs:annotation>
          <xs:documentation>Nivel SAE de automatización (0-5)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="sistemaActivo" type="SistemaActivoTipo" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>Sistemas de automatización activos (puede haber varios)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="anoUltimaRevisionSoftware" type="AnoFabricacionTipo">
        <xs:annotation>
          <xs:documentation>Año de la última revisión del software de autonomía</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- Vehículo -->
  <xs:complexType name="VehiculoTipo">
    <xs:annotation>
      <xs:documentation>
        Información completa de un vehículo en la flota,
        incluyendo características técnicas y nivel de automatización.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="marca" type="xs:string">
        <xs:annotation>
          <xs:documentation>Marca del vehículo (Tesla, BMW, etc.)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="modelo" type="xs:string">
        <xs:annotation>
          <xs:documentation>Modelo del vehículo</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="matricula" type="MatriculaTipo">
        <xs:annotation>
          <xs:documentation>Placa de matrícula (5-10 caracteres alfanuméricos)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="anoFabricacion" type="AnoFabricacionTipo">
        <xs:annotation>
          <xs:documentation>Año de fabricación</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="tipo" type="TipoVehiculoTipo">
        <xs:annotation>
          <xs:documentation>Tipo de vehículo (turismo, suv, furgoneta, camion)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="combustible" type="TipoCombustibleTipo">
        <xs:annotation>
          <xs:documentation>Tipo de combustible o energía</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="caracteristicas" type="CaracteristicasTipo">
        <xs:annotation>
          <xs:documentation>Especificaciones técnicas</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="automatizacion" type="AutomatizacionTipo">
        <xs:annotation>
          <xs:documentation>Información de automatización</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="sucursal" type="xs:string">
        <xs:annotation>
          <xs:documentation>Referencia IDREF a la sucursal donde está el vehículo</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="estado" type="EstadoVehiculoTipo">
        <xs:annotation>
          <xs:documentation>Estado del vehículo (disponible, alquilado, en-mantenimiento)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="tarifaDiaria" type="PrecioTipo">
        <xs:annotation>
          <xs:documentation>Tarifa diaria de alquiler (2 decimales)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="IDVehiculoTipo" use="required">
      <xs:annotation>
        <xs:documentation>Identificador único: veh + 4 dígitos</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Seguro -->
  <xs:complexType name="SeguroTipo">
    <xs:annotation>
      <xs:documentation>
        Información de un seguro disponible para el alquiler.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="nombre" type="xs:string">
        <xs:annotation>
          <xs:documentation>Nombre del seguro</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="descripcion" type="xs:string">
        <xs:annotation>
          <xs:documentation>Descripción detallada de la cobertura</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="cobertura" type="CoberturaSeguroTipo">
        <xs:annotation>
          <xs:documentation>Nivel de cobertura (basica, estandar, premium, integral)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="precioDia" type="PrecioTipo">
        <xs:annotation>
          <xs:documentation>Precio diario del seguro (2 decimales)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="franquicia" type="xs:decimal" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Franquicia en euros (0 para sin franquicia)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="nivelAutomatizacionMinimo" type="NivelAutomatizacionTipo" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Nivel mínimo de automatización requerido (opcional)</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="IDSeguroTipo" use="required">
      <xs:annotation>
        <xs:documentation>Identificador único: seg + 3 dígitos</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- Reserva -->
  <xs:complexType name="ReservaTipo">
    <xs:annotation>
      <xs:documentation>
        Información completa de una reserva incluyendo cliente, vehículo,
        sucursales y fechas.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="cliente" type="xs:string">
        <xs:annotation>
          <xs:documentation>Referencia IDREF al cliente que realiza la reserva</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="vehiculo" type="xs:string">
        <xs:annotation>
          <xs:documentation>Referencia IDREF al vehículo reservado</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="sucursalRecogida" type="xs:string">
        <xs:annotation>
          <xs:documentation>Referencia IDREF a la sucursal de recogida</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="sucursalDevolucion" type="xs:string">
        <xs:annotation>
          <xs:documentation>Referencia IDREF a la sucursal de devolución</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="fechaHoraRecogida" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation>Fecha y hora de recogida (YYYY-MM-DDTHH:MM:SS)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="fechaHoraDevolucionEstimada" type="xs:dateTime">
        <xs:annotation>
          <xs:documentation>Fecha y hora estimada de devolución (YYYY-MM-DDTHH:MM:SS)</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="estado" type="EstadoReservaTipo">
        <xs:annotation>
          <xs:documentation>Estado de la reserva</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="seguroContratado" type="xs:string">
        <xs:annotation>
          <xs:documentation>Referencia IDREF al seguro contratado</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="precioEstimado" type="xs:decimal">
        <xs:annotation>
          <xs:documentation>Precio estimado de la reserva</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="id" type="IDReservaTipo" use="required">
      <xs:annotation>
        <xs:documentation>Identificador único: res + 4 dígitos</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ============================================ -->
  <!-- ELEMENTOS RAÍZ -->
  <!-- ============================================ -->

  <!-- Elemento raíz: plataformaAlquiler -->
  <xs:element name="plataformaAlquiler">
    <xs:annotation>
      <xs:documentation>
        Elemento raíz que contiene toda la información de la plataforma:
        sucursales, seguros, vehículos, clientes y reservas.
      </xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <!-- Sucursales -->
        <xs:element name="sucursales" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Contenedor de sucursales</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="sucursal" type="SucursalTipo" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Sucursal individual</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Seguros -->
        <xs:element name="seguros" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Contenedor de seguros</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="seguro" type="SeguroTipo" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Seguro individual</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Vehículos -->
        <xs:element name="vehiculos" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Contenedor de vehículos</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="vehiculo" type="VehiculoTipo" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Vehículo individual</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Clientes -->
        <xs:element name="clientes" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Contenedor de clientes</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="cliente" type="ClienteTipo" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Cliente individual</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>

        <!-- Reservas -->
        <xs:element name="reservas" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Contenedor de reservas</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="reserva" type="ReservaTipo" maxOccurs="unbounded">
                <xs:annotation>
                  <xs:documentation>Reserva individual</xs:documentation>
                </xs:annotation>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>

  </xs:element>

</xs:schema>
