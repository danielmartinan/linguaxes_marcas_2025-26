<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="estadoEquipoType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="operativo"/>
      <xs:enumeration value="revision"/>
      <xs:enumeration value="baja"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="capacidadType">
    <xs:restriction base="xs:positiveInteger"/>
  </xs:simpleType>

  <xs:complexType name="equipoType">
    <xs:sequence>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="categoria" type="xs:string"/>
      <xs:element name="estado" type="estadoEquipoType"/>
      <xs:element name="fechaCompra" type="xs:date"/>
      <xs:element name="coste">
        <xs:simpleType>
          <xs:restriction base="xs:decimal">
            <xs:minInclusive value="0"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="responsable" type="xs:string"/>
    </xs:sequence>
    <xs:attribute name="codigo" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="salaType">
    <xs:sequence>
      <xs:element name="identificador" type="xs:string"/>
      <xs:element name="nombre" type="xs:string"/>
      <xs:element name="capacidad" type="capacidadType"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="inventario">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="equipo" type="equipoType" minOccurs="1" maxOccurs="unbounded"/>
        <xs:element name="sala" type="salaType" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>

    <xs:unique name="codigoEquipoUnico">
      <xs:selector xpath="equipo"/>
      <xs:field xpath="@codigo"/>
    </xs:unique>
  </xs:element>
</xs:schema>
